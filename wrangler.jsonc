{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptbin",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptbin-db",
      // Replace with the id printed by: npx wrangler d1 create promptbin-db
      "database_id": "cf6d132a-805a-4d1e-956e-dadd42397048",
      "migrations_dir": "migrations"
    },
    {
  "kv_namespaces": [
    {
      "binding": "promptbin-session",
      "id": "2679a999ba7344f9ba966873f4551665"
    }
  ]
}
  ]
  // Secrets (not stored here): ADMIN_PASSWORD, SESSION_SECRET
  //   npx wrangler secret put ADMIN_PASSWORD
  //   npx wrangler secret put SESSION_SECRET
  // Custom domain: add promptbin.in under Workers & Pages > promptbin > Settings > Domains & Routes.
}
