---
import Base from '../layouts/Base.astro';
import FilmStrip from '../components/FilmStrip.astro';
---
<Base title="Server error (500) | promptbin" description="Server error." noindex>
  <section class="hero2" data-tone="dusk" style="text-align:center">
    <FilmStrip />
    <div class="wrap err" style="padding-block:clamp(3rem,10vw,6rem)">
      <div class="code">500</div>
      <h1 style="font-size:clamp(1.6rem,4vw,2.4rem);margin-inline:auto;max-width:none">Something went wrong on our side</h1>
      <p class="sub" style="margin-inline:auto">Please try again in a minute. If the problem continues, contact us and tell us which page you were on.</p>
      <div class="acts" style="justify-content:center"><a class="btn" href="/">Go to home</a><a class="btn alt" href="/ai-photo-prompt-tool/">Open prompt tool</a><a class="btn alt" href="/blog/">Read the blog</a></div>
    </div>
  </section>
</Base>
