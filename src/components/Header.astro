---
import Logo from './Logo.astro';
import { SITE } from '../data/site.js';

const lang = Astro.url.searchParams.get('lang') || Astro.currentLocale || Astro.locals.lang || 'en';
const path = Astro.url.pathname;
const localize = (h) => (lang !== 'en' ? `${h}${h.includes('?') ? '&' : '?'}lang=${lang}` : h);
const tool = '/ai-photo-prompt-tool/';
const isActive = (h) => (h === '/' ? path === '/' : path.startsWith(h));

const LANGUAGES = [
  ['en', 'English'],
  ['hi', 'हिन्दी (Hindi)'],
  ['mr', 'मराठी (Marathi)'],
  ['bn', 'বাংলা (Bengali)'],
  ['ta', 'தமிழ் (Tamil)'],
  ['es', 'Español'],
  ['fr', 'Français'],
  ['de', 'Deutsch'],
  ['pt', 'Português'],
  ['ru', 'Русский'],
  ['ar', 'العربية'],
  ['tr', 'Türkçe'],
  ['id', 'Bahasa Indonesia'],
  ['ja', '日本語'],
  ['zh-CN', '简体中文'],
];
---
<header class="hd">
  <div class="wrap">
    <a class="logo notranslate" translate="no" href={localize('/')}><Logo />{SITE.name}</a>
    <nav class="nav" id="nav" aria-label="Main">
      {SITE.nav.map(([href, label]) => {
        const locHref = localize(href);
        return (
          <a href={locHref} class={href === tool && !isActive(href) ? 'cta' : undefined} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        );
      })}
    </nav>
    <div class="tools notranslate" translate="no">
      <label class="sr" for="lang">Language</label>
      <select class="lsel" id="lang" aria-label="Choose language" data-current={lang}>
        {LANGUAGES.map(([code, name]) => (
          <option value={code} selected={code === lang}>{name}</option>
        ))}
      </select>
      <button class="tbtn" id="theme" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Light / dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
    <button class="burger" id="nb" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span></button>
  </div>
</header>
