---
import { Image } from 'astro:assets';
import { getImgSafe } from '../data/images.js';
const { p, eager = false } = Astro.props;
const first = p.cats.split(' ')[0];
const tag = first[0].toUpperCase() + first.slice(1);
const alt = `${p.title}: sample result of ChatGPT AI photo editing prompts`;
const ph = p.image ? null : getImgSafe(p.slug);
const load = eager ? { loading: 'eager', decoding: 'sync', fetchpriority: 'high' } : { loading: 'lazy', decoding: 'async' };
---
<article class="print" data-c={p.cats}>
  {p.image ? (
    <img
      src={`/uploads/${p.image}-400.webp`}
      srcset={`/uploads/${p.image}-400.webp 400w, /uploads/${p.image}-800.webp 800w`}
      sizes="(max-width: 600px) 90vw, 270px"
      width="400" height="500" alt={alt} {...load}
    />
  ) : ph ? (
    <Image src={ph} width={400} height={500} alt={alt} {...load} />
  ) : (
    <div class="phimg" role="img" aria-label={alt}></div>
  )}
  <div class="cap"><h3>{p.title}</h3><span class="tag">{tag}</span></div>
  <p class="pt" translate="no" title="Tap to read the full prompt">{p.text}</p>
  <button class="btn sm" type="button" data-copy data-label="Copy Prompt">Copy Prompt</button>
</article>
