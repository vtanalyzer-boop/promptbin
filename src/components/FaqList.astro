---
const { title, items = [], intro = '' } = Astro.props;
---
<section class="sec w">
  <div class="wrap" style="max-width:860px">
    <h2>{title}</h2>
    {intro && <p class="intro">{intro}</p>}
    {(items || []).filter(Boolean).map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </div>
</section>
