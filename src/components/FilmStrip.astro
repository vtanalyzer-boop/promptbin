---
// Purely decorative drifting film strips: 2 rows x 14 frames of CSS gradients (no images, ~0 KB).
const frames = Array.from({ length: 14 });
---
<div class="filmstrip a" aria-hidden="true">{frames.map(() => <i />)}</div>
<div class="filmstrip b" aria-hidden="true">{frames.map(() => <i />)}</div>
