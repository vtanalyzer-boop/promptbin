{
  "name": "promptbin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply promptbin-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply promptbin-db --local",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "seo:keywords": "node scripts/keyword-report.mjs",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
